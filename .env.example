# Shared by the Python loop (loop/) and the Next.js UI (ui/).

# Liquid AI — "head gardener". Runs locally via llama.cpp (no key needed):
#   llama-server -hf LiquidAI/LFM2.5-VL-1.6B-GGUF:Q8_0 --jinja --port 8089 --alias LFM2.5-VL-1.6B
# Without BASE the loop uses the offline rule gardener. KEY is only for a hosted endpoint.
LIQUID_API_KEY=
LIQUID_API_BASE=http://127.0.0.1:8089/v1
LIQUID_MODEL=LFM2.5-VL-1.6B

# Nimble — web search for pest alerts + variety notes
NIMBLE_API_KEY=
NIMBLE_API_URL=https://sdk.nimbleway.com/v2/search
NIMBLE_SEARCH_EVERY_S=3600

# Forecast / frost risk (Open-Meteo, no key). Region is used in Nimble searches.
# Lancaster County, PA — prime farmland with a real autumn frost season.
GARDEN_LAT=40.0379
GARDEN_LON=-76.3055
GARDEN_REGION=Lancaster County, Pennsylvania

# RawTree — set to "rawtree" to also write every row via the `rtree` CLI (run `rtree login` first)
# RAWTREE_DATABASE picks the database the rows go to
PERENNIAL_STORE=
RAWTREE_DATABASE=perennial
# Local JSONL store shared by loop + UI; relative to the repo root
PERENNIAL_DATA_DIR=data

# Loop cadence (seconds) when running `python loop/main.py` continuously
PERENNIAL_LOOP_EVERY_S=300
# Scripted "cold snap Thursday" forecast for the live demo (1 = on, 0 = use the real forecast)
PERENNIAL_DEMO=0
