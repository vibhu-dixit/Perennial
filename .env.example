# Shared by the Python loop (loop/) and the Next.js UI (ui/).

# Liquid AI — "head gardener". OpenAI-compatible chat endpoint, e.g. https://<host>/v1
# Without both KEY and BASE the loop uses the offline rule gardener.
LIQUID_API_KEY=
LIQUID_API_BASE=
LIQUID_MODEL=

# Nimble — web search for pest alerts + variety notes (check your plan's endpoint)
NIMBLE_API_KEY=
NIMBLE_API_URL=
NIMBLE_SEARCH_EVERY_S=3600

# Forecast / frost risk (Open-Meteo, no key). Region is used in Nimble searches.
GARDEN_LAT=
GARDEN_LON=
GARDEN_REGION=

# RawTree — set to "rawtree" to also write every row via the `rtree` CLI (run `rtree login` first)
PERENNIAL_STORE=
# Local JSONL store shared by loop + UI; relative to the repo root
PERENNIAL_DATA_DIR=data

# Loop cadence (seconds) when running `python loop/main.py` continuously
PERENNIAL_LOOP_EVERY_S=300
# Scripted "cold snap Thursday" forecast for the live demo (1 = on, 0 = use the real forecast)
PERENNIAL_DEMO=1
