# Liquid AI — "head gardener" (gardener + answer calls). OpenAI-compatible chat endpoint.
LIQUID_API_KEY=
LIQUID_API_BASE=
LIQUID_MODEL=

# Nimble — external observations (weather, frost, pest alerts, variety notes)
NIMBLE_API_KEY=

# RawTree — append-only store. Log in with `rtree login`.
RAWTREE_PROJECT=

# Local JSONL fallback store shared by the loop and the UI (one <table>.jsonl per RawTree table)
PERENNIAL_DATA_DIR=./data
# Scripted "cold snap Thursday" Nimble injection for the live demo (1 = on)
PERENNIAL_DEMO=1
